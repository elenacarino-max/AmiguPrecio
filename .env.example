# Proveedor principal para los agentes. No versionar la clave real.
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-20b
# Opcionales: permiten ajustar cada rol sin cambiar el modelo del investigador.
GROQ_ANALYST_MODEL=groq/openai/gpt-oss-20b
GROQ_ADVISOR_MODEL=groq/openai/gpt-oss-20b

# Reservado para una futura fase multimodal; no se usa en la Fase 3 actual.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Limites de seguridad para una ejecucion completa.
MAX_LLM_CALLS=6
MAX_ESTIMATED_COST_EUR=0.50

